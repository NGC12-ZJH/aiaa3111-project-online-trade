* text=auto
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.docx binary
*.pdf binary
*.png binary

# Preserve the exact bytes recorded in the taxonomy final freeze manifest.
/data/taxonomy/v1_work/review_v1_decisions.csv -text whitespace=cr-at-eol
/data/taxonomy/gold/gold_final_v1.csv -text whitespace=cr-at-eol

# Preserve D Validation output bytes recorded in run manifests.
/results/tables/validation/** -text whitespace=cr-at-eol
/results/tables/validation_quality/** -text whitespace=cr-at-eol

/results/tables/validation_hybrid/** -text whitespace=cr-at-eol

/results/tables/validation_specificity/** -text whitespace=cr-at-eol
/results/tables/test/** -text whitespace=cr-at-eol

# Preserve the exact bytes recorded by the P5/90 follow-up freeze.
/experiments/validation_budget_redesign/results/verification.json -text whitespace=cr-at-eol
/experiments/validation_budget_redesign/results/global_local_A1_rule_paths.csv.gz -text
/experiments/validation_budget_redesign/test_p5_90/run.py -text whitespace=cr-at-eol,-blank-at-eof
/experiments/validation_budget_redesign/test_p5_90/frozen_rule_lists.csv -text whitespace=cr-at-eol
/experiments/validation_budget_redesign/test_p5_90/freeze.json -text whitespace=cr-at-eol

# Preserve the source and result bytes recorded by the shared-store and 1123 freezes.
/experiments/shared_full_store/** -text whitespace=cr-at-eol
/experiments/1123/** -text whitespace=cr-at-eol
/experiments/1123/replay_inputs/1122/**/*.py -text whitespace=cr-at-eol,-blank-at-eof
/experiments/discovery_residual_refill/run.py -text whitespace=cr-at-eol
